{
  "name": "peer.cat",
  "version": "2.0.0",
  "description": "Anonymous, encrypted peer-to-peer file sharing via WebRTC and WebTorrent",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx src/server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "tsx src/server/index.ts",
    "tracker": "tsx src/server/tracker.ts",
    "start": "concurrently \"npm run server\" \"vite preview --host 0.0.0.0\"",
    "typecheck": "tsc --noEmit",
    "peercat": "tsx bin/peercat.ts"
  },
  "bin": {
    "peercat": "./bin/peercat.ts"
  },
  "keywords": [
    "p2p",
    "file-sharing",
    "webrtc",
    "webtorrent",
    "encrypted",
    "anonymous",
    "e2ee"
  ],
  "author": "Pascal Raszyk",
  "license": "MIT",
  "dependencies": {
    "bittorrent-tracker": "^11.1.0",
    "concurrently": "^9.1.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "webtorrent": "^2.5.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
